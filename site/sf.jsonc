{
  "$schema": "https://spacefast.com/schemas/sf.json",
  // The Space this folder publishes to: https://lively-dune.space.fast/
  "space": "lively-dune",
  "name": "Component Vote",
  // handler.js answers every request that no file in this folder answers (the /api routes).
  // Spacefast gives it the Space's database as env.DB.
  "runtime": { "kind": "functions", "entry": "handler.js" }
}
